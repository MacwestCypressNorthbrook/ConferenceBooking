# ── Supabase → Project Settings → API Keys ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Lets the public booking page work without logins. Never expose it.
SUPABASE_SECRET_KEY=sb_secret_xxx
# Older projects: legacy keys work too
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Public URL used in email links ─────────────────────────────────────────
APP_URL=http://localhost:3000

# ── Email: set ONE of these. Resend wins if both are set. ──────────────────
EMAIL_FROM="Conference Hall <bookings@yourdomain.com>"

# Option A: Resend API (https://resend.com/api-keys; verify your sending domain first)
RESEND_API_KEY=

# Option B: any SMTP server (Google Workspace, Microsoft 365, Mailgun, or smtp.resend.com)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# true for port 465; leave empty for STARTTLS on 587
SMTP_SECURE=

# With neither set, emails are printed to the server console (handy in development).
