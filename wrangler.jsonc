{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Custom entry that wraps .open-next/worker.js and adds the cron handler.
	"main": "worker.ts",
	// Daily ping so Supabase doesn't pause the project after 7 idle days.
	"triggers": { "crons": ["0 6 * * *"] },
	// Must match the Worker name in Cloudflare (Workers & Pages → your project).
	"name": "conferencebooking",
	"compatibility_date": "2026-09-30",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference used by OpenNext; the service name must equal "name" above.
			"binding": "WORKER_SELF_REFERENCE",
			"service": "conferencebooking"
		}
	],
	"observability": { "enabled": true }
}
